---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import Faq from "../../components/Faq.astro";
import EndCta from "../../components/EndCta.astro";
import { faqSchema, type QA } from "../../data/faq";
import { SITE } from "../../data/site";
import { Image } from "astro:assets";
import faqCover from "../../assets/covers/faq.png";

const groups: { title: string; items: QA[] }[] = [
  {
    title: "Про Pocket Option",
    items: [
      {
        q: "Що таке Pocket Option?",
        a: "Pocket Option — онлайн-платформа для трейдингу, що працює з 2017 року. Тут можна торгувати валютами, криптовалютою, акціями, сировиною та індексами з угодами від $1 — у браузері, на Android, iPhone і в Telegram.",
      },
      {
        q: "PocketOption і Pocket Option — одне й те саме?",
        a: "Так. PocketOption — злите написання того самого брокера й тієї самої платформи на pocketoption.com. Українською його часто називають «Покет Опшн».",
      },
      {
        q: "Pocket Option — шахрайство чи ні?",
        a: 'Компанія працює з 2017 року й повідомляє про понад 10 млн зареєстрованих користувачів. Це офшорний брокер без регулятора першого рівня, тому захист клієнтів слабший, ніж у регульованих брокерів. Детальніше в нашому <a href="/ua/review/">огляді</a>.',
      },
      {
        q: "У яких країнах Pocket Option недоступний?",
        a: "Pocket Option не обслуговує мешканців країн ЄЕЗ, США, Великої Британії, Ізраїлю, Японії, Філіппін і Бразилії.",
      },
    ],
  },
  {
    title: "Акаунт і демо-рахунок",
    items: [
      {
        q: "Як відкрити рахунок у Pocket Option?",
        a: "Зареєструйтеся через email або Google, підтвердьте пошту, а перед першим виведенням пройдіть верифікацію в профілі.",
      },
      {
        q: "Демо-рахунок Pocket Option безкоштовний?",
        a: 'Так. На демо $50 000 віртуальних коштів, воно відкривається в один клік без реєстрації й не обмежене за терміном. Детальніше на сторінці <a href="/ua/demo-account/">демо-рахунку</a>.',
      },
      {
        q: "Чи можна увійти в Pocket Option через Google?",
        a: "Так. Якщо ви реєструвалися через Google, а згодом хочете входити за email і паролем, спершу задайте пароль через відновлення доступу.",
      },
      {
        q: "Які документи потрібні для верифікації?",
        a: "Чинний документ із фото й іноді підтвердження адреси. Дані в профілі мають збігатися з документами.",
      },
    ],
  },
  {
    title: "Поповнення і виведення",
    items: [
      { q: "Який мінімальний депозит?", a: "$5 для більшості способів оплати. Мінімальна сума угоди — $1." },
      {
        q: "Чи є комісії в Pocket Option?",
        a: "Pocket Option не бере комісію за поповнення й виведення. Свою комісію може утримати банк, емітент картки чи криптомережа.",
      },
      {
        q: "Чи є мінімальна сума виведення?",
        a: "Якщо немає активного бонусу на депозит, мінімальної та максимальної суми виведення немає.",
      },
      {
        q: "Скільки триває виведення коштів?",
        a: "Після верифікації виведення на електронні гаманці та в крипті часто надходить протягом доби. На картки й банківським переказом — до кількох робочих днів.",
      },
    ],
  },
  {
    title: "Торгівля",
    items: [
      {
        q: "Чим можна торгувати на Pocket Option?",
        a: "Понад 100 активів: валютні пари, криптовалюти, акції, сировина та індекси, плюс OTC-активи, які торгуються й у вихідні.",
      },
      {
        q: "Яка максимальна виплата?",
        a: "За звичайною угодою — як правило, до 92% залежно від активу й часу доби. Експрес-угоди, що об’єднують кілька прогнозів, дають до 218%.",
      },
      {
        q: "Чи є в Pocket Option копітрейдинг?",
        a: "Так. Можна автоматично копіювати угоди інших трейдерів і задавати власні ліміти.",
      },
      {
        q: "Чи є застосунок Pocket Option?",
        a: 'Так: для Android (Google Play або APK), вебзастосунок для iPhone та iPad, версія для браузера на ПК і Telegram-бот. Детальніше на <a href="/ua/app/">сторінці застосунку</a>.',
      },
    ],
  },
];
const all = groups.flatMap((g) => g.items);
const crumbs = [{ href: "/ua/", label: "Головна" }, { label: "FAQ" }];
const bc = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Головна", item: `${SITE.url}/ua/` },
    { "@type": "ListItem", position: 2, name: "FAQ", item: `${SITE.url}/ua/faq/` },
  ],
};
---

<Base
  ogImage="/og/faq.jpg"
  title="Pocket Option FAQ: вхід, демо-рахунок, депозит, виведення, застосунок"
  description="Відповіді на часті запитання про Pocket Option: шахрайство чи ні, країни, демо-рахунок, верифікація, мінімальний депозит, терміни виведення, виплати й застосунок."
  schema={[faqSchema(all), bc]}
>
  <PageHero
    slot="hero"
    title="Часті запитання про Pocket Option"
    lead="Прямі відповіді на найпопулярніші запитання про Pocket Option — від відкриття рахунку до виведення грошей."
    crumbs={crumbs}
    updated={SITE.updated}
  />
  <div class="w" style="padding-top:72px">
    <figure class="cover" style="max-width:740px">
      <Image
        src={faqCover}
        widths={[640, 960, 1200]}
        sizes="(max-width: 800px) 92vw, 740px"
        alt="Часті запитання про Pocket Option"
        loading="eager"
      />
    </figure>
  </div>
  {groups.map((g, i) => (
    <section class={i % 2 ? "alt" : ""}>
      <div class="w faq">
        <div class="sh">
          <h2>{g.title}</h2>
        </div>
        <Faq items={g.items} openFirst={i === 0} />
      </div>
    </section>
  ))}
  <div style="height:112px" />
  <EndCta />
</Base>
