---
import { PAYMENTS } from "../data/payments";
---

<ul class="pay">
  {PAYMENTS.map((p) =>
    p.label ? (
      <li class="mk">
        <img src={p.src} alt={p.alt} width="26" height="26" loading="lazy" />
        {p.label}
      </li>
    ) : (
      <li>
        <img src={p.src} alt={p.alt} style={`height:${p.h}px`} loading="lazy" />
      </li>
    ),
  )}
</ul>
<p class="pnote">
  Plus Jeton, Volet, WebMoney, Tron, Solana, local bank transfers, mobile money and 160+ more, depending on your
  country.
</p>
