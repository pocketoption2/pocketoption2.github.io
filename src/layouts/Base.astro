---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE } from "../data/site";

interface Props {
  title: string;
  description: string;
  schema?: object[];
  ogType?: string;
  noindex?: boolean;
}
const { title, description, schema = [], ogType = "website", noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const og = new URL("/og.png", SITE.url).href;
const ld = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": `${SITE.url}/#website`,
    url: `${SITE.url}/`,
    name: "Pocket Option",
    alternateName: ["PocketOption", "Pocket Option trading platform"],
    inLanguage: "en",
  },
  ...schema,
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#030816" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/po-icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Pocket Option" />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <div class="dark">
      <Header />
      <slot name="hero" />
    </div>
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
