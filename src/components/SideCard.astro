---
import { go } from "../data/site";
---

<div class="card">
  <h3>Pocket Option at a glance</h3>
  <dl>
    <dt>Minimum deposit</dt>
    <dd>$5</dd>
    <dt>Minimum trade</dt>
    <dd>$1</dd>
    <dt>Demo balance</dt>
    <dd>$50,000</dd>
    <dt>Assets</dt>
    <dd>100+</dd>
    <dt>Founded</dt>
    <dd>2017</dd>
  </dl>
  <a class="btn btn-p" href={go("register")} rel="sponsored nofollow">
    Open an account
  </a>
  <a class="btn btn-g" href={go("demo")} rel="sponsored nofollow">
    Try the free demo
  </a>
</div>
