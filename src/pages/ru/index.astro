---
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import Faq from "../../components/Faq.astro";
import EndCta from "../../components/EndCta.astro";
import PayGrid from "../../components/PayGrid.astro";
import Ico from "../../components/Ico.astro";
import desktop from "../../assets/platform-desktop.webp";
import mobile from "../../assets/platform-mobile.webp";
import { go } from "../../data/site";
import { HOME_FAQ_RU, faqSchema } from "../../data/faq";

const title = "Pocket Option (Покет Опшн): депозит от $5 и демо-счёт";
const description =
  "Pocket Option: депозит от $5, сделки от $1 и бесплатный демо-счёт на $50 000. Выплаты до 218%, приложение, 170+ способов пополнения и вывода.";
const kpis = [
  ["founded", "2017", "Год основания"],
  ["users", "10M+", "Пользователей"],
  ["deposit", "$5 / $1", "Мин. депозит / сделка"],
  ["demo", "$50 000", "На демо без регистрации"],
];
const specs = [
  ["platforms", "Платформы", ["Веб-версия", "Android", "Веб-приложение iOS", "Telegram-бот"]],
  ["payments", "Пополнение и вывод", ["Банковские карты", "Банковский перевод", "Электронные кошельки", "Мобильные платежи", "Криптовалюта"]],
  ["trades", "Типы сделок", ["Quick", "Digital", "Экспресс", "Отложенные", "Копитрейдинг"]],
  ["assets", "Активы", ["Форекс", "Криптовалюты", "Акции", "Сырьё", "Индексы"]],
];
const features = [
  [
    "social",
    "Копитрейдинг",
    "Подписывайтесь на опытных трейдеров и автоматически копируйте их сделки со своими лимитами по сумме.",
  ],
  [
    "signals",
    "Сигналы и индикаторы",
    "Встроенные торговые сигналы, а также RSI, MACD, полосы Боллинджера и другие индикаторы прямо на графике.",
  ],
  ["express", "Экспресс-сделки", "Объедините несколько прогнозов в одну сделку и получите повышенную выплату — до 218%."],
  ["pending", "Отложенные сделки", "Сделка откроется сама по заданной цене или времени — не нужно весь день сидеть у графика."],
  ["tournaments", "Турниры", "Соревнуйтесь за призовой фонд на отдельном балансе — есть бесплатные и платные турниры."],
  [
    "bonus",
    "Бонусы и кэшбэк",
    "Промокоды, бонусы на депозит и кэшбэк, которые периодически появляются в личном кабинете.",
  ],
];
---

<Base title={title} description={description} schema={[faqSchema(HOME_FAQ_RU)]}>
  <div class="w hg hero" slot="hero">
    <div>
      <h1>
        Pocket Option: начните торговать <b>всего с $5</b>
      </h1>
      <p class="lead">
        Валюты, криптовалюты, акции и сырьё на одной быстрой платформе, плюс бесплатный демо-счёт на $50 000. Разбираем
        комиссии, выплаты, приложение и способы оплаты ещё до регистрации.
      </p>
      <div class="cta">
        <a class="btn btn-p" href={go("register")} rel="sponsored nofollow">
          Открыть счёт в Pocket Option
        </a>
        <a class="btn btn-g" href={go("demo")} rel="sponsored nofollow">
          Попробовать демо
        </a>
      </div>
      <ul class="trust">
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <rect x="3" y="4.5" width="18" height="16" rx="2.5" />
            <path d="M3 9.5h18M8 2.5v4M16 2.5v4" />
          </svg>
          Работает с 2017 года
        </li>
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="9" cy="8" r="3.5" />
            <path d="M2.5 20c0-3.6 2.9-6 6.5-6s6.5 2.4 6.5 6" />
            <path d="M16 4.6a3.5 3.5 0 0 1 0 6.8M18 14.3c2.1.7 3.5 2.8 3.5 5.7" />
          </svg>
          10 млн+ пользователей
        </li>
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <rect x="2.5" y="5" width="19" height="14" rx="2.5" />
            <path d="M2.5 10h19M6.5 15h4" />
          </svg>
          170+ способов оплаты
        </li>
      </ul>
    </div>
    <div class="dev">
      <div class="lap">
        <Image
          src={desktop}
          widths={[640, 960, 1280, 1600]}
          sizes="(max-width: 1100px) 92vw, 760px"
          alt="Торговая платформа Pocket Option с графиком EUR/USD"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <div class="ph">
        <Image
          src={mobile}
          widths={[220, 340]}
          sizes="170px"
          alt="Экран торговли в мобильном приложении Pocket Option"
          loading="eager"
        />
      </div>
    </div>
  </div>

  <div class="w stats">
    <div>
      <b>$5</b>
      <span>Минимальный депозит</span>
    </div>
    <div>
      <b>$1</b>
      <span>Минимальная сделка</span>
    </div>
    <div>
      <b>$50 000</b>
      <span>Баланс демо-счёта</span>
    </div>
    <div>
      <b>218%</b>
      <span>Максимальная выплата</span>
    </div>
  </div>

  <section>
    <div class="w">
      <div class="gb-h">
        <div>
          <span class="lbl">Коротко о главном</span>
          <h2>Pocket Option: ключевые факты</h2>
        </div>
        <p>
          Данные сверены с самой платформой. Условия могут меняться, поэтому перед депозитом уточняйте их в личном кабинете.
          Подробно каждый пункт разобран в <a href="/ru/review/">полном обзоре</a>.
        </p>
      </div>
      <dl class="gb-k">
        {kpis.map(([i, v, l]) => (
          <div>
            <span class="gb-i">
              <Ico n={i} />
            </span>
            <dt>{l}</dt>
            <dd>{v}</dd>
          </div>
        ))}
      </dl>
      <div class="gb-s">
        {specs.map(([i, t, list]) => (
          <div class="gb-c">
            <h3>
              <Ico n={i as string} />
              {t}
            </h3>
            <ul class="chips">
              {(list as string[]).map((x) => (
                <li>{x}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <p class="gb-x">
        <Ico n="blocked" />
        <span>
          <strong>Недоступен в:</strong> странах ЕЭЗ, США, Великобритании, Израиле, Японии, на Филиппинах и в Бразилии.
        </span>
      </p>
    </div>
  </section>

  <section class="alt">
    <div class="w">
      <div class="sh">
        <span class="lbl">С чего начать</span>
        <h2>Открыть счёт — три шага</h2>
        <p>Регистрация занимает около минуты. На демо можно торговать сколько угодно, прежде чем вносить реальные деньги.</p>
      </div>
      <ol class="steps">
        <li>
          <h3>Зарегистрируйтесь</h3>
          <p>Войдите через email или Google и подтвердите почту — после этого станут доступны пополнение и вывод.</p>
        </li>
        <li>
          <h3>Потренируйтесь на демо</h3>
          <p>Переключитесь на демо-баланс $50 000 и без риска протестируйте активы, таймфреймы и индикаторы.</p>
        </li>
        <li>
          <h3>Пополните счёт и торгуйте</h3>
          <p>Внесите от $5 удобным местным способом и открывайте сделки от $1 в браузере или в приложении.</p>
        </li>
      </ol>
      <p class="more">
        <a href="/ru/how-to-trade/">Пошаговая инструкция по торговле →</a>
      </p>
    </div>
  </section>

  <section>
    <div class="w">
      <div class="sh">
        <span class="lbl">Возможности платформы</span>
        <h2>Больше, чем график и две кнопки</h2>
        <p>Инструменты, чтобы учиться, следить за сильными трейдерами и выжимать больше из каждого депозита.</p>
      </div>
      <div class="feat">
        {features.map(([i, h, p]) => (
          <div>
            <img class="fi" src={`/icons/feat-${i}.svg`} width="88" height="88" alt="" loading="lazy" />
            <h3>{h}</h3>
            <p>{p}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="w">
    <div class="appc">
      <div>
        <span class="lbl">Приложение Pocket Option</span>
        <h2>Ваш счёт — на любом устройстве</h2>
        <p>
          Те же активы, тот же баланс и та же история сделок в приложении для Android, веб-приложении для iPhone и в любом браузере на компьютере.
        </p>
        <div class="stores">
          <a href={go("android")} rel="sponsored nofollow">
            <i class="ic">
              <img src="/logos/android.svg" alt="" width="20" height="20" />
            </i>
            <span>
              <small>Скачать в</small>Google Play
            </span>
          </a>
          <a href={go("app")} rel="sponsored nofollow">
            <i class="ic ic-w">
              <img src="/logos/apple.svg" alt="" width="20" height="20" />
            </i>
            <span>
              <small>Установить</small>веб-приложение iPhone
            </span>
          </a>
          <a href={go("app")} rel="sponsored nofollow">
            <i class="ic">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="#fff"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <rect x="2.5" y="4" width="19" height="13" rx="2" />
                <path d="M8 21h8M12 17v4" />
              </svg>
            </i>
            <span>
              <small>Открыть в</small>браузере на ПК
            </span>
          </a>
          <a href={go("app")} rel="sponsored nofollow">
            <i class="ic">
              <img src="/logos/telegram.svg" alt="" width="20" height="20" />
            </i>
            <span>
              <small>Торговать через</small>Telegram-бот
            </span>
          </a>
        </div>
      </div>
      <div class="phone">
        <Image src={mobile} widths={[300, 560]} sizes="290px" alt="График в приложении Pocket Option с кнопками «Выше» и «Ниже»" />
      </div>
    </div>
  </div>

  <section>
    <div class="w">
      <div class="sh">
        <span class="lbl">Пополнение и вывод</span>
        <h2>Местные способы оплаты без комиссии Pocket Option</h2>
        <p>
          Более 170 вариантов — от банковских карт до мобильных платежей и криптовалюты. Доступность зависит от страны.{" "}
          <a href="/ru/deposit-withdrawal/">Как пополнить счёт и вывести деньги →</a>
        </p>
      </div>
      <PayGrid />
    </div>
  </section>

  <section class="alt">
    <div class="w">
      <div class="sh">
        <span class="lbl">Наш обзор</span>
        <h2>Плюсы и минусы</h2>
        <p>Идеальных брокеров не бывает. Взвесьте всё, прежде чем открывать реальный счёт.</p>
      </div>
      <div class="pc">
        <div>
          <h3>Что нравится</h3>
          <ul>
            <li>Низкий порог входа: депозит $5, сделки от $1</li>
            <li>Бессрочный демо-счёт с виртуальными $50 000</li>
            <li>Много местных и криптовалютных способов оплаты</li>
            <li>Копитрейдинг и встроенные сигналы</li>
            <li>Удобная и быстрая веб-платформа</li>
          </ul>
        </div>
        <div class="con">
          <h3>Что учесть</h3>
          <ul>
            <li>Краткосрочная торговля несёт высокий риск потерь</li>
            <li>Недоступен в ЕЭЗ, США, Великобритании и ряде других стран</li>
            <li>Бонусы нужно отыгрывать по обороту</li>
            <li>Перед выводом нужна верификация</li>
            <li>Офшорный брокер без регулятора первого уровня</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="w faq">
      <div class="sh">
        <span class="lbl">FAQ</span>
        <h2>Частые вопросы о Pocket Option</h2>
        <p>
          Короткие ответы на то, что чаще всего ищут о Pocket Option.{" "}
          <a href="/ru/faq/">Все вопросы →</a>
        </p>
      </div>
      <Faq items={HOME_FAQ_RU} />
    </div>
  </section>

  <EndCta />
</Base>
