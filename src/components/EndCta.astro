---
import { go } from "../data/site";
import { getLang, t } from "../i18n";
const s = t(getLang(Astro.url));
const { title = s.endTitle, text = s.endText } = Astro.props;
---

<div class="w">
  <div class="end">
    <div>
      <h2 set:html={title.replace(s.endNowrap, `<span class="nw">${s.endNowrap}</span>`)} />
      <p>{text}</p>
    </div>
    <div class="cta">
      <a class="btn btn-p" href={go("demo")} rel="sponsored nofollow">
        {s.tryFree}
      </a>
      <a class="btn btn-g" href={go("register")} rel="sponsored nofollow">
        {s.openAccount}
      </a>
    </div>
  </div>
</div>
