---
import Logo from "./Logo.astro";
import { FOOTER } from "../data/site";
import { getLang, lp, t } from "../i18n";
const lang = getLang(Astro.url);
const s = t(lang);
const year = new Date().getFullYear();
---

<footer class="site">
  <div class="w">
    <div class="ft">
      <div>
        <a class="logo" href={lp(lang, "/")}>
          <Logo size={26} />
          <span class="wm">
            <b>Pocket</b>Option
          </span>
        </a>
        <p>{s.footAbout}</p>
      </div>
      {FOOTER.map((col, i) => (
        <details open>
          <summary>
            <h2>{s.footCols[i]}</h2>
          </summary>
          <ul>
            {col.links.filter((l: any) => lang === "en" || !l.en).map((l) => (
              <li>
                <a href={lp(lang, l.href)}>{s.footLinks[l.href] ?? l.label}</a>
              </li>
            ))}
          </ul>
        </details>
      ))}
    </div>
    <p class="risk">{s.risk}</p>
  </div>
  <div class="copy">
    <div class="w">
      <span>© {year} pocketoption2.github.io. {s.rights}</span>
      <ul>
        <li>
          <a href="/privacy/">{s.footLinks["/privacy/"]}</a>
        </li>
        <li>
          <a href="/disclaimer/">{s.footLinks["/disclaimer/"]}</a>
        </li>
        <li>
          <a href="/risk-warning/">{s.footLinks["/risk-warning/"]}</a>
        </li>
        <li>
          <a href="/contact/">{s.footLinks["/contact/"]}</a>
        </li>
      </ul>
    </div>
  </div>
</footer>

<script>
  const mq = matchMedia("(max-width: 640px)");
  const sync = () =>
    document.querySelectorAll<HTMLDetailsElement>(".ft details").forEach((d) => (d.open = !mq.matches));
  sync();
  mq.addEventListener("change", sync);
</script>
