---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Faq from "../components/Faq.astro";
import EndCta from "../components/EndCta.astro";
import PayGrid from "../components/PayGrid.astro";
import Ico from "../components/Ico.astro";
import desktop from "../assets/platform-desktop.webp";
import mobile from "../assets/platform-mobile.webp";
import { go } from "../data/site";
import { HOME_FAQ, faqSchema } from "../data/faq";

const title = "Pocket Option: Trading Platform with $5 Deposit & Free Demo";
const description =
  "Trade on Pocket Option with a $5 deposit, $1 trades and a free $50,000 demo. PocketOption fees, payouts, app and 170+ payment methods explained.";
const kpis = [
  ["founded", "2017", "Founded"],
  ["users", "10M+", "Registered users"],
  ["deposit", "$5 / $1", "Min. deposit / trade"],
  ["demo", "$50,000", "Demo funds, no sign-up"],
];
const specs = [
  ["platforms", "Platforms", ["Web", "Android app", "iOS web app", "Telegram bot"]],
  ["payments", "Payment methods", ["Cards", "Bank transfer", "E-wallets", "Mobile money", "Crypto"]],
  ["trades", "Trade types", ["Quick", "Digital", "Express", "Pending", "Copy trading"]],
  ["assets", "Assets", ["Forex", "Crypto", "Stocks", "Commodities", "Indices"]],
];
const features = [
  [
    "social",
    "Social trading",
    "Follow experienced traders and copy their positions automatically, with your own amount limits.",
  ],
  [
    "signals",
    "Signals and indicators",
    "Built-in trading signals plus RSI, MACD, Bollinger Bands and more on every chart.",
  ],
  ["express", "Express trades", "Combine several forecasts into one trade for a higher potential payout, up to 218%."],
  ["pending", "Pending trades", "Open a trade automatically at a chosen price or time instead of watching the chart."],
  ["tournaments", "Tournaments", "Compete on a separate balance for prize pools, with free and paid entry options."],
  [
    "bonus",
    "Bonuses and cashback",
    "Promo codes, deposit bonuses and cashback offers that appear in your account over time.",
  ],
];
---

<Base title={title} description={description} schema={[faqSchema(HOME_FAQ)]}>
  <div class="w hg hero" slot="hero">
    <div>
      <h1>
        Pocket Option: start trading with <b>just $5</b>
      </h1>
      <p class="lead">
        PocketOption gives you currencies, crypto, stocks and commodities on one fast platform, with a free $50,000 demo
        account. Fees, payouts, app and payments, explained before you sign up.
      </p>
      <div class="cta">
        <a class="btn btn-p" href={go("register")} rel="sponsored nofollow">
          Open a Pocket Option account
        </a>
        <a class="btn btn-g" href={go("demo")} rel="sponsored nofollow">
          Try the free demo
        </a>
      </div>
      <ul class="trust">
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <rect x="3" y="4.5" width="18" height="16" rx="2.5" />
            <path d="M3 9.5h18M8 2.5v4M16 2.5v4" />
          </svg>
          Founded in 2017
        </li>
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="9" cy="8" r="3.5" />
            <path d="M2.5 20c0-3.6 2.9-6 6.5-6s6.5 2.4 6.5 6" />
            <path d="M16 4.6a3.5 3.5 0 0 1 0 6.8M18 14.3c2.1.7 3.5 2.8 3.5 5.7" />
          </svg>
          10M+ registered users
        </li>
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <rect x="2.5" y="5" width="19" height="14" rx="2.5" />
            <path d="M2.5 10h19M6.5 15h4" />
          </svg>
          170+ payment methods
        </li>
      </ul>
    </div>
    <div class="dev">
      <div class="lap">
        <Image
          src={desktop}
          widths={[640, 960, 1280, 1600]}
          sizes="(max-width: 1100px) 92vw, 760px"
          alt="PocketOption web trading platform with EUR/USD chart"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <div class="ph">
        <Image
          src={mobile}
          widths={[220, 340]}
          sizes="170px"
          alt="Pocket Option mobile app trading screen"
          loading="eager"
        />
      </div>
    </div>
  </div>

  <div class="w stats">
    <div>
      <b>$5</b>
      <span>Minimum deposit</span>
    </div>
    <div>
      <b>$1</b>
      <span>Minimum trade amount</span>
    </div>
    <div>
      <b>$50,000</b>
      <span>Virtual demo balance</span>
    </div>
    <div>
      <b>218%</b>
      <span>Maximum payout</span>
    </div>
  </div>

  <section>
    <div class="w">
      <div class="gb-h">
        <div>
          <span class="lbl">At a glance</span>
          <h2>Pocket Option, the key facts</h2>
        </div>
        <p>
          Checked against the platform itself. Conditions can change, so confirm them in your account before you
          deposit. The <a href="/review/">full review</a> covers each point in detail.
        </p>
      </div>
      <dl class="gb-k">
        {kpis.map(([i, v, l]) => (
          <div>
            <span class="gb-i">
              <Ico n={i} />
            </span>
            <dt>{l}</dt>
            <dd>{v}</dd>
          </div>
        ))}
      </dl>
      <div class="gb-s">
        {specs.map(([i, t, list]) => (
          <div class="gb-c">
            <h3>
              <Ico n={i as string} />
              {t}
            </h3>
            <ul class="chips">
              {(list as string[]).map((x) => (
                <li>{x}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <p class="gb-x">
        <Ico n="blocked" />
        <span>
          <strong>Not available in:</strong> EEA, USA, UK, Israel, Japan, Philippines and Brazil.
        </span>
      </p>
    </div>
  </section>

  <section class="alt">
    <div class="w">
      <div class="sh">
        <span class="lbl">Getting started</span>
        <h2>Open an account in three steps</h2>
        <p>Registration takes about a minute. Stay on the demo as long as you like before adding real money.</p>
      </div>
      <ol class="steps">
        <li>
          <h3>Create your account</h3>
          <p>Sign up with email or Google, then confirm your email to unlock deposits and withdrawals.</p>
        </li>
        <li>
          <h3>Practise on the demo</h3>
          <p>Switch to the $50,000 demo balance and test assets, timeframes and indicators risk-free.</p>
        </li>
        <li>
          <h3>Fund and trade</h3>
          <p>Deposit from $5 with a local payment method and open trades from $1 on web or mobile.</p>
        </li>
      </ol>
      <p class="more">
        <a href="/how-to-trade/">Read the step-by-step trading walkthrough →</a>
      </p>
    </div>
  </section>

  <section>
    <div class="w">
      <div class="sh">
        <span class="lbl">Platform features</span>
        <h2>More than a chart and two buttons</h2>
        <p>Tools for learning, following other traders and getting more from each deposit.</p>
      </div>
      <div class="feat">
        {features.map(([i, h, p]) => (
          <div>
            <img class="fi" src={`/icons/feat-${i}.svg`} width="88" height="88" alt="" loading="lazy" />
            <h3>{h}</h3>
            <p>{p}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="w">
    <div class="appc">
      <div>
        <span class="lbl">Pocket Option app</span>
        <h2>Your account, on every screen</h2>
        <p>
          Same assets, same balance and same history on the Android app, the iPhone web app and any desktop browser.
        </p>
        <div class="stores">
          <a href={go("android")} rel="sponsored nofollow">
            <i class="ic">
              <img src="/logos/android.svg" alt="" width="20" height="20" />
            </i>
            <span>
              <small>Get it on</small>Google Play
            </span>
          </a>
          <a href={go("app")} rel="sponsored nofollow">
            <i class="ic ic-w">
              <img src="/logos/apple.svg" alt="" width="20" height="20" />
            </i>
            <span>
              <small>Install as</small>iPhone web app
            </span>
          </a>
          <a href={go("app")} rel="sponsored nofollow">
            <i class="ic">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="#fff"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <rect x="2.5" y="4" width="19" height="13" rx="2" />
                <path d="M8 21h8M12 17v4" />
              </svg>
            </i>
            <span>
              <small>Open in</small>Desktop browser
            </span>
          </a>
          <a href={go("app")} rel="sponsored nofollow">
            <i class="ic">
              <img src="/logos/telegram.svg" alt="" width="20" height="20" />
            </i>
            <span>
              <small>Trade via</small>Telegram bot
            </span>
          </a>
        </div>
      </div>
      <div class="phone">
        <Image src={mobile} widths={[300, 560]} sizes="290px" alt="PocketOption app chart with buy and sell buttons" />
      </div>
    </div>
  </div>

  <section>
    <div class="w">
      <div class="sh">
        <span class="lbl">Deposits and withdrawals</span>
        <h2>Local payment methods, no Pocket Option fees</h2>
        <p>
          Over 170 options, from cards to mobile money and crypto. Availability depends on your country.{" "}
          <a href="/deposit-withdrawal/">How deposits and withdrawals work →</a>
        </p>
      </div>
      <PayGrid />
    </div>
  </section>

  <section class="alt">
    <div class="w">
      <div class="sh">
        <span class="lbl">Our review</span>
        <h2>Strengths and trade-offs</h2>
        <p>No platform suits everyone. Weigh both sides before you open a real account.</p>
      </div>
      <div class="pc">
        <div>
          <h3>What works well</h3>
          <ul>
            <li>Low entry: $5 deposit, $1 trades</li>
            <li>Unlimited demo with $50,000 virtual funds</li>
            <li>Wide choice of local and crypto payment methods</li>
            <li>Social trading and built-in signals</li>
            <li>Clean, fast web platform</li>
          </ul>
        </div>
        <div class="con">
          <h3>What to keep in mind</h3>
          <ul>
            <li>Short-term trading carries a high risk of loss</li>
            <li>Not available in the EEA, USA, UK and some other countries</li>
            <li>Bonuses come with turnover requirements</li>
            <li>Verification is required before withdrawals</li>
            <li>Offshore broker, not a tier-1 regulator</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="w faq">
      <div class="sh">
        <span class="lbl">FAQ</span>
        <h2>Questions traders ask about Pocket Option</h2>
        <p>
          Short answers to what people search most about Pocket Option and PocketOption.{" "}
          <a href="/faq/">See all questions →</a>
        </p>
      </div>
      <Faq items={HOME_FAQ} />
    </div>
  </section>

  <EndCta />
</Base>
