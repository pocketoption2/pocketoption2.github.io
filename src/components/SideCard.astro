---
import { go } from "../data/site";
import { getLang, t } from "../i18n";
const s = t(getLang(Astro.url));
---

<div class="card">
  <h3>{s.side.title}</h3>
  <dl>
    {s.side.rows.map(([k, v]) => (
      <>
        <dt>{k}</dt>
        <dd>{v}</dd>
      </>
    ))}
  </dl>
  <a class="btn btn-p" href={go("register")} rel="sponsored nofollow">
    {s.side.open}
  </a>
  <a class="btn btn-g" href={go("demo")} rel="sponsored nofollow">
    {s.tryFree}
  </a>
</div>
