---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found | Pocket Option" description="The page you are looking for does not exist." noindex>
  <div class="w ph-hero" slot="hero">
    <p class="crumbs">Error 404</p>
    <h1>This page does not exist</h1>
    <p class="lead">The link may be old or mistyped. Try one of these instead.</p>
    <div class="cta">
      <a class="btn btn-p" href="/">
        Back to home
      </a>
      <a class="btn btn-g" href="/faq/">
        Read the FAQ
      </a>
    </div>
  </div>
</Base>
