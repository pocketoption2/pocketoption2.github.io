---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import Faq from "../../components/Faq.astro";
import EndCta from "../../components/EndCta.astro";
import { faqSchema, type QA } from "../../data/faq";
import { SITE } from "../../data/site";
import { Image } from "astro:assets";
import faqCover from "../../assets/covers/faq.png";

const groups: { title: string; items: QA[] }[] = [
  {
    title: "О Pocket Option",
    items: [
      {
        q: "Что такое Pocket Option?",
        a: "Pocket Option — онлайн-платформа для трейдинга, работающая с 2017 года. Здесь можно торговать валютами, криптовалютой, акциями, сырьём и индексами со сделками от $1 — в браузере, на Android, iPhone и в Telegram.",
      },
      {
        q: "PocketOption и Pocket Option — одно и то же?",
        a: "Да. PocketOption — слитное написание того же брокера и той же платформы на pocketoption.com. По-русски его часто называют «Покет Опшн».",
      },
      {
        q: "Pocket Option — развод или нет?",
        a: 'Компания работает с 2017 года и сообщает о более чем 10 млн зарегистрированных пользователей. Это офшорный брокер без регулятора первого уровня, поэтому защита клиентов слабее, чем у регулируемых брокеров. Подробнее в нашем <a href="/ru/review/">обзоре</a>.',
      },
      {
        q: "В каких странах Pocket Option недоступен?",
        a: "Pocket Option не обслуживает жителей стран ЕЭЗ, США, Великобритании, Израиля, Японии, Филиппин и Бразилии.",
      },
    ],
  },
  {
    title: "Аккаунт и демо-счёт",
    items: [
      {
        q: "Как открыть счёт в Pocket Option?",
        a: "Зарегистрируйтесь через email или Google, подтвердите почту, а перед первым выводом пройдите верификацию в профиле.",
      },
      {
        q: "Демо-счёт Pocket Option бесплатный?",
        a: 'Да. На демо $50 000 виртуальных средств, оно открывается в один клик без регистрации и не ограничено по сроку. Подробнее на странице <a href="/ru/demo-account/">демо-счёта</a>.',
      },
      {
        q: "Можно ли войти в Pocket Option через Google?",
        a: "Да. Если вы регистрировались через Google, а потом хотите входить по email и паролю, сначала задайте пароль через восстановление доступа.",
      },
      {
        q: "Какие документы нужны для верификации?",
        a: "Действующий документ с фото и иногда подтверждение адреса. Данные в профиле должны совпадать с документами.",
      },
    ],
  },
  {
    title: "Пополнение и вывод",
    items: [
      { q: "Какой минимальный депозит?", a: "$5 для большинства способов оплаты. Минимальная сумма сделки — $1." },
      {
        q: "Есть ли комиссии у Pocket Option?",
        a: "Pocket Option не берёт комиссию за пополнение и вывод. Свою комиссию может удержать банк, эмитент карты или криптосеть.",
      },
      {
        q: "Есть ли минимальная сумма вывода?",
        a: "Если нет активного бонуса на депозит, минимальной и максимальной суммы вывода нет.",
      },
      {
        q: "Сколько идёт вывод средств?",
        a: "После верификации вывод на электронные кошельки и в крипте часто приходит в течение суток. На карты и банковским переводом — до нескольких рабочих дней.",
      },
    ],
  },
  {
    title: "Торговля",
    items: [
      {
        q: "Чем можно торговать на Pocket Option?",
        a: "Более 100 активов: валютные пары, криптовалюты, акции, сырьё и индексы, плюс OTC-активы, которые торгуются и в выходные.",
      },
      {
        q: "Какая максимальная выплата?",
        a: "По обычной сделке — как правило, до 92% в зависимости от актива и времени суток. Экспресс-сделки, объединяющие несколько прогнозов, дают до 218%.",
      },
      {
        q: "Есть ли в Pocket Option копитрейдинг?",
        a: "Да. Можно автоматически копировать сделки других трейдеров и задавать свои лимиты.",
      },
      {
        q: "Есть ли приложение Pocket Option?",
        a: 'Да: для Android (Google Play или APK), веб-приложение для iPhone и iPad, версия для браузера на ПК и Telegram-бот. Подробнее на <a href="/ru/app/">странице приложения</a>.',
      },
    ],
  },
];
const all = groups.flatMap((g) => g.items);
const crumbs = [{ href: "/ru/", label: "Главная" }, { label: "FAQ" }];
const bc = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Главная", item: `${SITE.url}/ru/` },
    { "@type": "ListItem", position: 2, name: "FAQ", item: `${SITE.url}/ru/faq/` },
  ],
};
---

<Base
  ogImage="/og/faq.jpg"
  title="Pocket Option FAQ: вход, демо-счёт, депозит, вывод и приложение"
  description="Ответы на частые вопросы о Pocket Option: развод или нет, страны, демо-счёт, верификация, минимальный депозит, сроки вывода, выплаты и приложение."
  schema={[faqSchema(all), bc]}
>
  <PageHero
    slot="hero"
    title="Частые вопросы о Pocket Option"
    lead="Прямые ответы на самые популярные вопросы о Pocket Option — от открытия счёта до вывода денег."
    crumbs={crumbs}
    updated={SITE.updated}
  />
  <div class="w" style="padding-top:72px">
    <figure class="cover" style="max-width:740px">
      <Image
        src={faqCover}
        widths={[640, 960, 1200]}
        sizes="(max-width: 800px) 92vw, 740px"
        alt="Частые вопросы о Pocket Option"
        loading="eager"
      />
    </figure>
  </div>
  {groups.map((g, i) => (
    <section class={i % 2 ? "alt" : ""}>
      <div class="w faq">
        <div class="sh">
          <h2>{g.title}</h2>
        </div>
        <Faq items={g.items} openFirst={i === 0} />
      </div>
    </section>
  ))}
  <div style="height:112px" />
  <EndCta />
</Base>
